# Existing Fitlek settings
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fitlekdb
DB_CONNECTION_LIMIT=5
JWT_SECRET=replace-with-a-long-random-secret

# Current Workout access is free; Stripe keys are not required.

# CORS: comma-separated explicit allowed web origins. Empty permits all origins
# only outside NODE_ENV=production. Production also requires a random JWT secret
# of at least 32 characters and a certificate-backed HTTPS PUBLIC_API_ORIGIN.
# CORS_ORIGINS=https://your-web-app.example,https://admin.example
CORS_ORIGINS=
PUBLIC_API_ORIGIN=
# Set to 1 only behind exactly one trusted reverse proxy; direct server uses 0.
TRUST_PROXY_HOPS=0
NODE_ENV=development
RESEND_API_KEY=
SENDER_EMAIL=
# Production: provide Firebase service account JSON using your secret manager.
FIREBASE_SERVICE_ACCOUNT=
# Local QA suppresses scheduled outbound delivery; production normally uses 0.
WORKOUT_REMINDERS_DISABLED=1
